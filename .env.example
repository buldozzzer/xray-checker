# Порт на хосте для веб-интерфейса
HOST_PORT=8090

# Подписка remnawave
SUB_URL=https://example.com/account/your-subscription-id
SUB_USER_AGENT=Happ/5.6.0/ios/2608171408551

# Проверки
CHECK_TIMEOUT=60
CHECK_CONCURRENCY=24
# Секунды между автопроверками, 0 = выкл.
AUTO_CHECK_INTERVAL=0
# Секунды между фоновыми проверками серверов, отмеченных ★ (43200 = 12 ч), 0 = выкл.
WATCH_CHECK_INTERVAL=43200
# Сколько дней хранить историю проверок, 0 = бессрочно
HISTORY_DAYS=90
